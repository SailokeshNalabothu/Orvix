FROM eclipse-temurin:21-jre-jammy

LABEL maintainer="Orvix Engineering Team"
LABEL description="Orvix Billing Service - Double-Entry Ledger, Outbox & 3-Tier Reconciliation"

RUN groupadd --gid 10001 orvix && \
    useradd --uid 10001 --gid orvix --shell /bin/false --create-home appuser && \
    apt-get update && apt-get install -y --no-install-recommends curl && \
    rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY billing-service/target/billing-service-1.0.0-SNAPSHOT.jar app.jar

RUN chown -R appuser:orvix /app

USER 10001:10001

EXPOSE 8083

ENV JAVA_OPTS="-XX:+UseG1GC -XX:MaxRAMPercentage=75.0 -XX:InitialRAMPercentage=50.0 -XX:+ExitOnOutOfMemoryError -Djava.security.egd=file:/dev/./urandom"

ENTRYPOINT ["sh", "-c", "exec java $JAVA_OPTS -jar app.jar"]
